<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>com.liveroom</groupId>
	<artifactId>liveroom-demo-server</artifactId>
	<version>1.0.0</version>
	<packaging>war</packaging>

	<name>LiveRoomDemo Server</name>
	<description>基于 Spring Boot + WebSocket 的直播间 Demo 服务端：聊天室、弹幕、在线人数统计</description>
	<url>https://github.com/jack-hoo/LiveRoomDemo_Server</url>

	<licenses>
		<license>
			<name>MIT License</name>
			<url>https://opensource.org/licenses/MIT</url>
			<distribution>repo</distribution>
		</license>
	</licenses>

	<scm>
		<url>https://github.com/jack-hoo/LiveRoomDemo_Server</url>
		<connection>scm:git:https://github.com/jack-hoo/LiveRoomDemo_Server.git</connection>
	</scm>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>1.5.4.RELEASE</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
		<!-- Spring Boot 1.5.x 只支持到 Java 8，用更高版本的 JDK 编译会失败 -->
		<java.version>1.8</java.version>
	</properties>

	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-devtools</artifactId>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-redis</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-thymeleaf</artifactId>
		</dependency>
		<!-- thymeleaf 的 LEGACYHTML5 宽松模式需要它来解析非闭合标签 -->
		<dependency>
			<groupId>net.sourceforge.nekohtml</groupId>
			<artifactId>nekohtml</artifactId>
			<version>1.9.22</version>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<!--
			tomcat 用 provided 而不是 exclude：
			- provided 时 mvn spring-boot:run / java -jar 依然能用内嵌 tomcat 启动；
			- 打成 war 丢给外部 tomcat 时，这份依赖不会进 WEB-INF/lib，不会和容器自带的冲突。
			原来直接 exclude 掉，结果是这个项目只能部署到外部容器，本地根本跑不起来。
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-tomcat</artifactId>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-websocket</artifactId>
		</dependency>
		<dependency>
			<groupId>mysql</groupId>
			<artifactId>mysql-connector-java</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!--
			以下依赖在代码里没有任何引用，已移除：
			spring-boot-actuator-docs、reactor-core、reactor-net、netty-all、
			joda-time、org.webjars:vue（前端 vue.js 是直接放在 static 目录下的）。
			STOMP relay 走的是 spring-messaging 自带的实现，不需要 reactor/netty。
		-->
	</dependencies>

	<build>
		<!--
			war 包名决定外部 tomcat 下的访问路径，前端接口前缀写死为 /LiveDemo，
			所以这里固定成 LiveDemo，避免带上版本号变成 /liveroom-demo-server-1.0.0。
		-->
		<finalName>LiveDemo</finalName>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<fork>true</fork>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>
